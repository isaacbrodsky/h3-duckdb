# Adapted from the coverage.sh.in script in the uber/h3 repo.

set -e

if [[ $<BOOL:$<CONFIG:Debug>> != 1 ]]; then
    echo "Cannot run coverage for non-debug build" 1>&2
    exit 1
fi

src_dir=${1:-"Missing source directory"}
binary_dir=${2:-"Missing binary directory"}

# Exclude the usual LCOV exclusion comment
br_exclusion='LCOV_EXCL_BR_LINE'

cd "${binary_dir}"
lcov --ignore-errors inconsistent,mismatch --rc "lcov_excl_br_line=$br_exclusion" --directory . --capture --output-file coverage.info
lcov --ignore-errors inconsistent,mismatch --rc "lcov_excl_br_line=$br_exclusion" --extract coverage.info "${src_dir}/src/*" --output-file coverage.cleaned.info
genhtml --ignore-errors inconsistent,category -o coverage coverage.cleaned.info --title 'duckdb-h3 coverage'
